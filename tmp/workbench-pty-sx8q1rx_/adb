#!/usr/bin/env python3
"""Deterministic adb substitute. Never invokes adb or touches a device."""
import json, os, shlex, struct, sys, time, zlib
from pathlib import Path
root = Path(os.environ['MYLOGGER_FAKE_ROOT'])
args = sys.argv[1:]
with (root/'calls.jsonl').open('a') as out:
    out.write(json.dumps(args, ensure_ascii=False)+'\n')
mode = (root/'mode').read_text() if (root/'mode').exists() else os.environ.get('MYLOGGER_FAKE_MODE', '')
if args == ['devices']:
    if mode == 'devices-error':
        print('device discovery failed', file=sys.stderr); sys.exit(1)
    print('List of devices attached')
    if mode != 'none': print('first\tdevice')
    if mode == 'two': print('second\tdevice')
    print('locked\tunauthorized\nlost\toffline')
    sys.exit(0)
assert args[:1] == ['-s'], args
serial = args[1]
assert serial in ('first','second'), serial
args = args[2:]
def remote(path):
    return root/'remote'/serial/path.lstrip('/')
def png_chunk(name, content):
    return struct.pack('>I',len(content))+name+content+struct.pack('>I',zlib.crc32(name+content))
if args == ['exec-out','screencap','-p']:
    data = b'\x89PNG\r\n\x1a\n'+png_chunk(b'IHDR',struct.pack('>2I5B',1,1,8,2,0,0,0))+png_chunk(b'IDAT',zlib.compress(b'\x00\xff\x80\x00'))+png_chunk(b'IEND',b'')
    sys.stdout.buffer.write(data if mode != 'bad-png' else data[:20]); sys.exit(0)
if args[:1] == ['install']:
    if mode == 'semantic': print('Failure [INSTALL_FAILED_UPDATE_INCOMPATIBLE]')
    elif mode == 'exit-error': print('installation failed',file=sys.stderr);sys.exit(7)
    else: print('Success')
    sys.exit(0)
if args[:1] in (['forward'], ['reverse']):
    direction = args[0]
    state = root/f'{serial}-{direction}.json'
    entries=json.loads(state.read_text()) if state.exists() else {}
    if args[1:] == ['--list']:
        for source,dest in entries.items(): print(serial,source,dest)
        if direction == 'forward': print('other tcp:7777 tcp:7778')
    elif args[1] == '--no-rebind':
        if args[2] in entries: print('cannot rebind',file=sys.stderr);sys.exit(1)
        entries[args[2]]=args[3]
    elif args[1] == '--remove': entries.pop(args[2],None)
    else: raise AssertionError(args)
    state.write_text(json.dumps(entries));sys.exit(0)
if args[:1] == ['push']:
    dest=remote(args[2]);dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes(Path(args[1]).read_bytes());print('1 file pushed');sys.exit(0)
if args[:1] == ['pull']:
    Path(args[2]).write_bytes(remote(args[1]).read_bytes());print('1 file pulled');sys.exit(0)
if args[:2] == ['logcat','--help']:
    print('--uid=<uid>' if mode != 'pid' else 'legacy logcat');sys.exit(0)
if args[:2] == ['logcat','-c']: sys.exit(0)
if args[:1] == ['logcat']:
    (root/'logcat.pid').write_text(str(os.getpid()))
    for i in range(10000):
        pid=12 if i<60 else 22
        print(f'11-10 10:00:00.000 {pid} {pid} I Tag: selected-{pid}-{i}',flush=True)
        # --uid is applied by logcat itself on supporting devices.
        if mode == 'pid':
            print(f'11-10 10:00:00.000 999 999 E Other: com.demo.app unrelated-{i}',flush=True)
            print(f'11-10 10:00:00.000 13 13 W Worker: subprocess-{i}',flush=True)
        time.sleep(.02)
    sys.exit(0)
assert args[:1] == ['shell'], args
parts=shlex.split(args[1])
if parts[:1] == ['getprop']:
    print({'ro.product.model':'Fake Pixel','ro.build.version.release':'14','ro.build.version.sdk':'34','ro.product.cpu.abi':'arm64-v8a'}[parts[1]])
elif parts[:2] == ['wm','size']: print('Physical size: 1080x2400')
elif parts[:2] == ['wm','density']: print('Physical density: 420')
elif parts[:3] == ['pm','list','packages']: print('package:com.demo.app\npackage:com.demo.other')
elif parts[:2] == ['dumpsys','package']:
    print(f'Package [{parts[2]}] (abc):\n userId=10123\n versionName=1.2\n flags=[ HAS_CODE DEBUGGABLE ]')
elif parts[:3] == ['dumpsys','activity','activities']: print('mResumedActivity: ActivityRecord{123 u0 com.demo.app/.MainActivity t1}')
elif parts[:3] == ['cmd','package','resolve-activity']: print('com.demo.app/.MainActivity')
elif parts[:2] == ['am','start']:
    if mode == 'semantic': print('Error: Activity not started')
    else: print('Status: ok')
elif parts[:2] == ['am','force-stop']: pass
elif parts[:1] == ['ps']:
    counter=root/'ps-count';count=int(counter.read_text())+1 if counter.exists() else 1;counter.write_text(str(count))
    print('PID NAME\n12 com.demo.app\n13 com.demo.app:worker' if count<3 else 'PID NAME\n22 com.demo.app')
elif parts[:1] == ['if']:
    path=remote(parts[3]);print('DIRECTORY' if path.is_dir() else 'EXISTS' if path.exists() else 'NEW')
elif parts[:2] == ['test','-f']:
    sys.exit(0 if remote(parts[2]).is_file() else 1)
elif parts[:3] == ['test','!','-d']:
    dest=remote(parts[3]);mv=parts.index('mv');flag,src,destination=parts[mv+1:mv+4];src=remote(src)
    if dest.is_dir() or (flag=='-n' and dest.exists()):sys.exit(1)
    src.replace(dest)
else: raise AssertionError(parts)
