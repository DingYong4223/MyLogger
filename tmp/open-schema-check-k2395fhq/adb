#!/Users/delanding/.local/share/mise/installs/python/3.14.3/bin/python3
import json, os, shlex, sys
args = sys.argv[1:]
assert args[0] == 'shell', args
parts = shlex.split(args[1])
assert parts[:6] == ['am', 'start', '-W', '-a', 'android.intent.action.VIEW', '-d'], parts
assert len(parts) == 7, parts
schema = parts[6]
with open(os.environ['MYLOGGER_SCHEMA_TEST_LOG'], 'a') as out:
    out.write(json.dumps({'schema': schema, 'args': args}, ensure_ascii=False) + '\n')
if schema.endswith('fail-adb'):
    print('error: device unauthorized', file=sys.stderr)
    sys.exit(1)
if schema.endswith('fail-am'):
    print('Error: Activity not started, unable to resolve Intent')
elif schema.endswith('fail-status'):
    print('Status: timeout')
else:
    print('Status: ok\nComplete')
